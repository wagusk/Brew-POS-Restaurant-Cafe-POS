[Unit]
Description=Brew-POS — restaurant point of sale (FastAPI + static UI)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=30

[Service]
Type=simple
WorkingDirectory=/home/lenovo/Hermes-Project/Brew-POS
Environment=PATH=/home/lenovo/Hermes-Project/Brew-POS/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=BREWPOS_HOST=0.0.0.0
Environment=BREWPOS_PORT=8000
ExecStart=/home/lenovo/Hermes-Project/Brew-POS/.venv/bin/uvicorn app.main:app --app-dir /home/lenovo/Hermes-Project/Brew-POS/backend --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
StartLimitIntervalSec=0
StandardOutput=append:/home/lenovo/Hermes-Project/Brew-POS/.hermes/brewpos.log
StandardError=append:/home/lenovo/Hermes-Project/Brew-POS/.hermes/brewpos.log

[Install]
WantedBy=default.target
