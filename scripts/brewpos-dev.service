[Unit]
Description=Brew-POS Vite dev server (frontend hot-reload on :5173)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/lenovo/Hermes-Project/Brew-POS/frontend
Environment=PATH=/home/lenovo/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOST=0.0.0.0
Environment=PORT=5173
ExecStart=/usr/bin/env bash -lc 'cd /home/lenovo/Hermes-Project/Brew-POS/frontend && npm run dev -- --host 0.0.0.0 --port 5173'
Restart=always
RestartSec=3
StandardOutput=append:/home/lenovo/Hermes-Project/Brew-POS/.hermes/brewpos-dev.log
StandardError=append:/home/lenovo/Hermes-Project/Brew-POS/.hermes/brewpos-dev.log

[Install]
WantedBy=default.target
